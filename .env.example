# ====== Database ======
# Used by the postgres service and composed into DATABASE_URL.
POSTGRES_PASSWORD=changeme
# Runtime + migrations connection string.
#   - In Docker (prod), host is the service name `postgres`.
#   - For LOCAL dev against docker-compose.dev.yml, use @localhost:5432.
DATABASE_URL=postgres://als:changeme@postgres:5432/als

# ====== Auth (single-user password gate) ======
# 32-byte secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-openssl-rand-base64-32
# SHA-256 hex of your app password. Generate with:
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('YOUR_PASSWORD')).then(b=>console.log(Buffer.from(b).toString('hex')))"
APP_PASSWORD_HASH=replace-with-sha256-hex-of-your-password

# ====== AI query layer (OpenRouter) ======
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ====== Runtime ======
NODE_ENV=production
